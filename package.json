{
  "name": "@bottlify/cellar",
  "version": "0.9.0",
  "type": "module",
  "license": "MPL-2.0",
  "description": "Shared-memory primitives for multithreaded JavaScript: thread synchronization, byte rings, channels between threads and a cache of bodies read in place",
  "homepage": "https://github.com/bottlify/cellar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottlify/cellar.git"
  },
  "bugs": {
    "url": "https://github.com/bottlify/cellar/issues"
  },
  "keywords": [
    "javascript",
    "multithreading",
    "concurrency",
    "shared-memory",
    "sharedarraybuffer",
    "atomics",
    "web-workers",
    "worker-threads",
    "ring-buffer",
    "zero-copy",
    "cache",
    "opfs",
    "browser"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.itest.js",
    "!src/**/*.fixture.js",
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=60000 \"src/**/*.test.js\"",
    "test:integration": "node --test --test-timeout=600000 \"src/**/*.itest.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run test:integration && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
